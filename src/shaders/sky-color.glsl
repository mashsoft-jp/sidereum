
    // 昼の空の色 (地上ビュー)。空ドームと、天体に上乗せする大気の光 (エアライト)
    // で同じ式を使うため切り出してある。夜 (day=0) は黒を返すので、そのまま
    // 加算しても夜空を持ち上げない。
    //   d = 視線方向 (地平フレーム [東, 天頂, -北])  s = 太陽方向  day = 昼夜係数
    //
    // 返すのはリニアの放射輝度。定数は「tonemap を通すと従来と同じ画面上の色に
    // なる」逆算値をそのまま書いてある。見た目を保ったまま、混色だけリニアで行う
    vec3 skyDayColor(vec3 d, vec3 s, float day) {
      float h = clamp(d.y, 0.0, 1.0);
      vec3 zen = vec3(0.0279, 0.0714, 0.2477);   // 画面上の (0.16, 0.34, 0.68)
      vec3 hor = vec3(0.1546, 0.2679, 0.6850);   //           (0.55, 0.70, 0.88)
      vec3 c = mix(hor, zen, pow(h, 0.55));
      // 夕焼けは「太陽を中心とした円」ではなく「地平線に沿った帯」になる。
      // 視線と太陽の角度 (dot) だけで decide すると、空の高いところまで一様に
      // 染まった円い滲みになってしまうので、方位と高さを分けて効かせる。
      //   方位 … 広い (西の空ぜんたいが焼ける)
      //   高さ … 狭い (地平から数十度で青へ戻る)
      vec3 sn = normalize(s);
      vec2 dh = vec2(d.x, d.z);
      vec2 sh = vec2(sn.x, sn.z);
      float dl = length(dh), sl = length(sh);
      float azi = (dl > 1e-4 && sl > 1e-4) ? max(dot(dh / dl, sh / sl), 0.0) : 1.0;
      float low = 1.0 - smoothstep(0.0, 0.35, sn.y);
      float band = exp(-h * 5.0);                     // 地平に貼りつく帯
      vec3 warm = mix(vec3(1.4295, 0.1546, 0.0475),   // (0.95, 0.55, 0.25)
                      vec3(0.9500, 0.1400, 0.0980),   // (0.92, 0.52, 0.42) 桃橙
                      low);
      c = mix(c, warm, low * pow(azi, 1.4) * band * 0.95);
      // 太陽のすぐ上、地平ぎわだけに乗る黄白の芯。ここが無いと全体が桃色に
      // 沈んで「焼けている」感じが出ない
      vec3 hot = vec3(2.2000, 0.9500, 0.2905);        // (0.98, 0.92, 0.72)
      c = mix(c, hot, low * pow(azi, 7.0) * exp(-h * 16.0) * 0.85);
      // 地平近くはうっすら霞む
      c = mix(c, mix(c, vec3(0.2905, 0.3453, 0.4656), 0.35),   // (0.72, 0.76, 0.82)
              1.0 - smoothstep(0.0, 0.18, h));
      return c * day;
    }
